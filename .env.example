# UPI collection (same configuration as Kitchan)
PAYTM_UPI_ID=your-vpa@paytm
PAYTM_MERCHANT_NAME=Store
PHONEPE_MERCHANT_NAME=Store

# Paytm Order Status API. Tracking stays pending when PAYTM_MID is empty.
PAYTM_MID=
# PAYTM_ENV=test

# Optional Meta Pixel IDs
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_EXTRA_PIXELS=

# Server-only Meta Conversions API credential; never use a NEXT_PUBLIC prefix
META_ACCESS_TOKEN=
# Dataset/pixel authorized by this token (comma separated if needed)
META_PIXEL_ID=
META_API_VERSION=v25.0
STORE_URL=https://your-store.example
